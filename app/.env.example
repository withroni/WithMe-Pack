# Photo recognition. Leave both unset and the app falls back to its built-in
# demo list (a canned result after 1.5s) — everything else still works.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle and can be read out of a
# shipped binary. Test builds only; see server/README.md.

EXPO_PUBLIC_SCAN_URL=https://your-deployment.vercel.app/api/scan
EXPO_PUBLIC_SCAN_TOKEN=
